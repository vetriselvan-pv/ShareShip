{
  "name": "shareship-workspace",
  "version": "1.0.0",
  "description": "Shareship — Collaborative Application for Partners & Families",
  "type": "module",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "debug:backend": "cd backend && npm run debug",
    "debug:backend:watch": "cd backend && npm run debug:watch",
    "build:backend": "cd backend && npm install && npm run build",
    "dev:frontend": "cd frontend && npm start",
    "build:frontend": "cd frontend && npm install && npm run build",
    "build": "cd backend && npm install && npm run build"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "fastify": "^5.0.0",
    "mongoose": "^9.11.4",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "shareship",
    "angular",
    "ionic",
    "capacitor",
    "fastify",
    "realtime-sync"
  ]
}
